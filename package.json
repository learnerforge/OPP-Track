{
  "name": "opp-track",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:app": "tsc -p app/tsconfig.json && vite build --config app/vite.config.ts",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-data.mjs",
    "validate:links": "node scripts/validate-data.mjs --check-links",
    "test": "node tests/migration.test.mjs",
    "scrape": "python scripts/scrapers/run_all.py",
    "scrape:quick": "python scripts/scrapers/run_all.py --quick",
    "scrape:detailed": "python scripts/scrapers/run_all.py --detailed",
    "scrape:devfolio": "python scripts/scrapers/run_all.py --devfolio",
    "scrape:devpost": "python scripts/scrapers/run_all.py --devpost",
    "scrape:unstop": "python scripts/scrapers/run_all.py --unstop",
    "scrape:hackerearth": "python scripts/scrapers/run_all.py --hackerearth",
    "scrape:internshala": "python scripts/scrapers/run_all.py --internshala",
    "scrape:multi": "python scripts/scrapers/run_all.py --multi",
    "scrape:enrich": "python scripts/scrapers/run_all.py --enrich",
    "scrape:quality": "python scripts/scrapers/run_all.py --quality",
    "scrape:validate": "python scripts/scrapers/run_all.py --validate",
    "scrape:sources": "python scripts/scrapers/multi_source.py --list",
    "merge:seeds": "python scripts/merge_seeds.py",
    "check:freeze": "python scripts/check_freeze.py",
    "publish:data": "python scripts/publish_dataset.py --with-seeds",
    "verify:all": "npm run typecheck && npm test && npm run validate"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "radix-ui": "^1.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
