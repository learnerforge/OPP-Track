# Only api/, data/, public/, app/, and the root configs participate in the
# Vercel build. src/ is EXCLUDED: it is the frozen original app and is no
# longer deployed (the public 3-page app in app/ replaced it) — excluding it
# also keeps Tailwind v4's build-server content scan off that tree.
src/
frontend/
docs/
tests/
scripts/
# root dist/ is the OLD app's build output — never shipped. app/dist/ is the
# NEW app's build output and MUST be uploaded (Vercel reads outputDirectory).
dist/
data/backups/
data/raw/
fullstack.md
# NOTE: do not add a blanket *.md rule — api/report/latest.ts reads
# data/reports/publish-*.md from the deployed filesystem at runtime.
# .vercelignore replaces .gitignore for uploads — carry over the safety entries
.env*
.vercel_python_packages/
__pycache__/
*.pyc
.venv/
venv/
validation_*.txt
*.log
